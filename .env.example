# ─── Application ───────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Database Environment ───────────────────────────────────────
# Switch between 'local' and 'aiven' to change which DB is used
DB_ENV=local

# ─── Local MySQL ────────────────────────────────────────────────
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=3306
LOCAL_DB_USER=root
LOCAL_DB_PASSWORD=your_local_mysql_password
LOCAL_DB_NAME=school_management

# ─── Aiven Cloud MySQL ──────────────────────────────────────────
# Get these from your Aiven console → Services → your MySQL service → Connection info
AIVEN_DB_HOST=mysql-xxxx-xxxx.aivencloud.com
AIVEN_DB_PORT=12345
AIVEN_DB_USER=avnadmin
AIVEN_DB_PASSWORD=your_aiven_password
AIVEN_DB_NAME=defaultdb
